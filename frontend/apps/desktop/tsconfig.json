{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/api/studio": [
        "src/api/studio.ts"
      ],
      "@/stores/auth": [
        "src/stores/auth.ts"
      ],
      "@/*": [
        "../web/src/*"
      ],
      "@desktop/*": [
        "src/*"
      ],
      "@web/*": [
        "../web/src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../web/src/views/**/*.vue",
    "../web/src/components/**/*.vue",
    "../web/src/components/**/*.ts",
    "../web/src/composables/**/*.ts",
    "../web/src/constants/**/*.ts",
    "../web/src/stores/**/*.ts",
    "../web/src/utils/**/*.ts",
    "../web/src/api/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.vue",
    "vite.config.ts"
  ]
}
